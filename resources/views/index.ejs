<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Action Tracker | Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <div class="app-container">
    <aside class="sidebar">
      <div class="logo">At</div>
      <nav class="nav-icons">
        <div class="icon active">🏠</div>
        <div class="icon">📊</div>
        <div class="icon">⚙️</div>
      </nav>
    </aside>

    <main class="main-content">
      <section class="table-container">
        <div class="task-table">
          <div class="search-wrapper" style="margin-bottom: 20px;">
            <input type="text" id="taskSearch" placeholder="🔍 Поиск задачи или исполнителя..." onkeyup="filterTasks()" style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 8px;">
          </div>
          <div class="table-header">
            <span>Задача</span>
            <span>Категория</span>
            <span title="Подзадачи" style="display: flex; justify-content: center; align-items: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.6;">
                <path d="M3 3h6v6H3zM15 15h6v6h-6zM15 3h6v6h-6zM9 6h6M12 6v12M12 18h3" />
              </svg>
            </span>
            <span>Ответственный</span>
            <span>Срок</span>
            <span>Дней</span>

            <span>Статус</span>
            <span></span>
          </div>

          <% tasks.forEach(task=> { %>
          <% const subtaskCount = tasks.filter(t => t.parent_id === task.id).length; %>
          <% const hasChildren = subtaskCount > 0; %>
          <div class="task-row <%= task.isSubtask ? 'is-subtask' : '' %>" <% if(task.isSubtask) { %> data-parent-id="<%= task.parent_id %>" style="display: none;" <% } %>>
            <div class="task-clickable-area" onclick="openDetails('<%= task.title %>', '<%= task.assigned_to %>')">
              <span class="task-title">
                <% if (!task.isSubtask) { %>
                <span class="toggle-icon" onclick="event.stopPropagation(); toggleSubtasks('<%= task.id %>', this)" style="<%= hasChildren ? '' : 'visibility: hidden;' %>">▶</span>
                <% } %>

                <span class="task-title-wrapper">
                  <span class="task-title-text"><%= task.title %></span>
                  <button class="edit-icon-btn" onclick="event.stopPropagation(); editTask(this.previousElementSibling, '<%= task.id %>', 'title')">✎</button>
                </span>
              </span>

              <span class="task-category-wrapper">
                <span class="task-category-text"><%= task.category %></span>
                <button class="edit-icon-btn" onclick="event.stopPropagation(); editTask(this.previousElementSibling, '<%= task.id %>', 'category')">✎</button>
              </span>

              <span class="subtask-count">
                <% if (!task.isSubtask && subtaskCount > 0) { %>
                <span class="subtask-badge <%= subtaskCount > 5 ? 'has-many' : '' %>">
                  <%= subtaskCount %>
                </span>
                <% } %>
              </span>
              <span><%= task.assigned_to %></span>
              <span><%= task.deadline_at %></span>
              <span class="<%= task.daysLeft <= 1 ? 'days-critical' : task.daysLeft <= 3 ? 'days-warning' : '' %>">
                <%= task.daysLeft %>
              </span>
              <span class="task-status <%= task.status?.toLowerCase() === 'просрочено' ? 'status-overdue' : 
                task.status?.toLowerCase() === 'открыто' ? 'status-open' :
                task.status?.toLowerCase() === 'в работе' ? 'status-progress' :
                task.status?.toLowerCase() === 'готово' ? 'status-done' : 
                task.status?.toLowerCase() === 'на паузе' ? 'status-paused' :
                task.status?.toLowerCase() === 'отменено' ? 'status-cancelled' : 'status-open' %>" onclick="event.stopPropagation(); editStatus(this, '<%= task.id %>')" data-original-value="<%= task.status %>">
                <%= task.status %>
              </span>
            </div>

            <div class="task-actions">
              <% if (!task.isSubtask) { %>
              <button onclick="event.stopPropagation(); toggleSubtaskForm('<%= task.id %>')" title="Добавить подзадачу">➕</button>
              <% } %>
              <a href="/tasks/delete/<%= task.id %>" class="delete-btn" title="Удалить задачу" onclick="event.stopPropagation();">🗑️</a>
            </div>
          </div>

          <% if (!task.isSubtask) { %>
          <form action="/tasks" method="POST" id="form-sub-<%= task.id %>" class="task-row is-subtask inline-add-form hidden">
            <input type="hidden" name="parent_id" value="<%= task.id %>">
            <input type="text" name="title" placeholder="Название подзадачи..." required>
            <input type="text" name="category" placeholder="Категория" required>
            <input type="text" readonly>
            <input type="text" name="assigned_to" placeholder="Ответственный" required>
            <input type="date" name="deadline_at" required>
            <input type="text" readonly>
            <input type="text" name="status" value="Открыто" required>
            <button type="submit" class="mini-add-btn">ОК</button>
          </form>
          <% } %>
          <% }); %>

          <form action="/tasks" method="POST" class="task-row inline-add-form main-add-row">
            <input type="text" name="title" placeholder="Начните ввод новой задачи..." required>
            <input type="text" name="category" placeholder="Категория" required>
            <input type="text" readonly class="invisible">
            <input type="text" name="assigned_to" placeholder="Ответственный" required>
            <input type="date" name="deadline_at" required>
            <input type="text" readonly class="invisible">
            <input type="text" name="status" placeholder="Статус" required>
            <button type="submit" class="add-btn-large">Добавить задачу</button>
          </form>
        </div>
      </section>
    </main>

    <div id="overlay" class="overlay" onclick="closeDetails()"></div>

    <aside id="details-panel" class="details-panel">
      <button class="close-btn" onclick="closeDetails()">✕</button>
      <div class="panel-content">
        <h2 id="panel-title">Детали задачи</h2>
        <hr>
        <p><strong>Исполнитель:</strong> <span id="panel-user"></span></p>
        <div class="dummy-text">
          Здесь будет описание задачи, комментарии и история изменений.
        </div>
      </div>
    </aside>
  </div>

  <script src="/main.js"></script>
</body>

</html>