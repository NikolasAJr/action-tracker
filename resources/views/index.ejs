<!DOCTYPE html>
<html lang="ru">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Action Tracker | Dashboard</title>
	<link rel="stylesheet" href="/css/style.css">
</head>

<body>
	<div class="app-container">
		<aside class="sidebar">
			<div class="logo">A</div>
			<nav class="nav-icons">
				<div class="icon active">🏠</div>
				<div class="icon">📊</div>
				<div class="icon">⚙️</div>
			</nav>
		</aside>

		<main class="main-content">
			<header class="top-bar">
				<h1>Action Tracker</h1>
				<form class="add-task-form" action="/tasks" method="POST">
					<input type="text" name="task_description" placeholder="Что сделать?" required>
					<input type="text" name="assigned_to" placeholder="Исполнитель">
					<input type="date" name="deadline" placeholder="Срок исполнения">
					<input type="text" name="status" placeholder="Статус">
					<button type="submit">Добавить</button>
				</form>
			</header>

			<section class="table-container">
				<div class="task-table">
					<div class="table-header">
						<span>Задача</span>
						<span>Исполнитель</span>
						<span>Срок исполнения</span>
						<span>Осталось дней</span>
						<span>Статус</span>
						<span></span>
					</div>
					<% tasks.forEach(task=> { %>
						<div class="task-row <%= task.isSubtask ? 'is-subtask' : '' %>">
							<div class="task-clickable-area" style="display: contents" onclick="openDetails()">
								<span>
									<%= task.task_description %>
								</span>
								<span>
									<%= task.assigned_to %>
								</span>
								<span>
									<%= task.deadline %>
								</span>
								<span>
									<%= task.daysLeft %>
								</span>
								<span class="task-status">
									<%= task.status %>
								</span>
							</div>

							<div class="task-actions">
								<% if (!task.isSubtask) { %>
									<button onclick="addSubtask('<%= task.id %>')" title="Добавить подзадачу">➕</button>
									<% } %>
										<a href="/tasks/delete/<%= task.id %>" class="delete-btn">🗑️</a>
							</div>
						</div>
						<% }); %>
				</div>
			</section>
		</main>

		<div id="overlay" class="overlay" onclick="closeDetails()"></div>

		<aside id="details-panel" class="details-panel">
			<button class="close-btn" onclick="closeDetails()">✕</button>
			<div class="panel-content">
				<h2 id="panel-title">Детали задачи</h2>
				<hr>
				<p><strong>Исполнитель:</strong> <span id="panel-user"></span></p>
				<div class="dummy-text">
					Здесь будет описание задачи, комментарии и история изменений.
				</div>
			</div>
		</aside>
	</div>

	<script>
		function openDetails(task_description, user) {
			document.getElementById('panel-title').innerText = task_description;
			document.getElementById('panel-user').innerText = user;
			document.getElementById('details-panel').classList.add('open');
			document.getElementById('overlay').classList.add('visible');
		}

		function closeDetails() {
			document.getElementById('details-panel').classList.remove('open');
			document.getElementById('overlay').classList.remove('visible');
		}

		function addSubtask(parentId) {
			// Можно либо открывать модальное окно, 
			// либо просто скроллить к основной форме и добавлять hidden input
			let form = document.querySelector('.add-task-form');

			// Удаляем старый parent_id если был
			let oldInput = document.getElementById('parent-id-input');
			if (oldInput) oldInput.remove();

			// Добавляем новый
			let input = document.createElement('input');
			input.type = 'hidden';
			input.name = 'parent_id';
			input.id = 'parent-id-input';
			input.value = parentId;
			form.appendChild(input);

			// Подсветим форму
			form.querySelector('input[name="task_description"]').placeholder = "Подзадача...";
			form.querySelector('input[name="task_description"]').focus();
		}
	</script>
</body>

</html>