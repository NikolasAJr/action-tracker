<!DOCTYPE html>
<html lang="ru" data-theme="<%= user.theme || 'standard' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Action Tracker | Dashboard</title>
  <link rel="stylesheet" href="./css/style.css">
  <link rel="stylesheet" href="./css/aside-panel.css">
  <script>
    // Глобальная переменная нужна для модуля dropdown.js
    window.CATEGORIES = <%- JSON.stringify(categories.map(c => c.name)) %>;
    window.SESSION = {
      username: "<%= user ? user.username : undefined %>"
    };
  </script>
</head>

<body>
  <div class="app-container">
    <aside class="sidebar">
      <div class="logo">At</div>
      <nav class="nav-icons">
        <div class="icon active">🏠</div>
        <% if (user.role === 'admin') { %>
        <a href="/admin" class="icon" title="Пользователи" style="text-decoration:none; display:block; text-align:center;">👥</a>
        <% } %>
        <div class="icon">📊</div>
        <div class="icon" id="settings-trigger" style="position: relative;">⚙️
          <div id="settings-menu" class="settings-dropdown hidden">
            <div class="theme-option" data-val="standard">Стандарт</div>
            <div class="theme-option" data-val="light">Светлая</div>
            <div class="theme-option" data-val="dark">Темная</div>
          </div>
        </div>

        <div style="margin-top: auto; display: flex; flex-direction: column; align-items: center; gap: 10px; padding-bottom: 20px;">
          <div title="<%= user.username %> (<%= user.role %>)" style="width: 32px; height: 32px; background: #e4e4e7; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 12px; color: #52525b;">
            <%= user.username.charAt(0).toUpperCase() %>
          </div>
          <a href="/logout" style="text-decoration: none; color: #ef4444; font-size: 20px;" title="Выйти">✕</a>
        </div>

      </nav>
    </aside>

    <main class="main-content">
      <section class="table-container">
        <div class="task-table" id="task-table-root">
          <div class="search-wrapper" style="margin-bottom: 20px;">
            <input type="text" id="taskSearch" class="task-search-input" placeholder="🔍 Поиск задачи или исполнителя...">
          </div>

          <div class="table-header">
            <span>Задача</span>
            <span>Категория</span>
            <span>Приоритет</span>
            <span title="Подзадачи">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.6;">
                <path d="M3 3h6v6H3zM15 15h6v6h-6zM15 3h6v6h-6zM9 6h6M12 6v12M12 18h3" />
              </svg>
            </span>
            <span>Ответственный</span>
            <span>Срок</span>
            <span>Дней</span>
            <span>Статус</span>
            <span></span>
          </div>

          <% tasks.forEach(task => { %>
          <% const subtaskCount = tasks.filter(t => t.parent_id === task.id).length; %>
          <% const hasChildren = subtaskCount > 0; %>

          <!-- ОТРИСОВКА ГЛАВНОЙ ЗАДАЧИ И ЕЁ ПОДЗАДАЧ -->
          <div class="task-row <%= task.isSubtask ? 'is-subtask' : '' %>" <% if (task.isSubtask) { %> data-parent-id="<%= task.parent_id %>" style="display: none;" <% } %>>
            <div class="task-clickable-area">
              <span class="task-title">
                <% if (!task.isSubtask) { %>
                <span class="toggle-icon" data-action="toggle-subtasks" data-id="<%= task.id %>" style="<%= hasChildren ? '' : 'visibility: hidden;' %>">▶</span>
                <% } %>
                <span class="task-title-wrapper">
                  <span class="task-title-text" data-action="open-details" data-id="<%= task.id %>"><%= task.title %></span>
                  <button class="edit-icon-btn" data-action="edit-field-btn" data-field="title" data-id="<%= task.id %>">✎</button>
                </span>
              </span>

              <span class="task-category-wrapper">
                <span class="task-category-text" data-action="edit-category" data-id="<%= task.id %>"><%= task.category || '—' %></span>
              </span>

              <span class="task-priority-wrapper">
                <span class="priority-badge <%= getPriorityClass(task.priority) %>" data-action="edit-priority" data-id="<%= task.id %>">
                  <%= getPriorityLabel(task.priority) %>
                </span>
              </span>

              <span class="subtask-count">
                <% if (!task.isSubtask && subtaskCount > 0) { %>
                <span class="subtask-badge <%= subtaskCount > 5 ? 'has-many' : '' %>"><%= subtaskCount %></span>
                <% } %>
              </span>
              <span class="task-assignee-wrapper">
                <span class="task-assignee-text" data-action="edit-field-text" data-field="assigned_to" data-id="<%= task.id %>"><%= task.assigned_to %></span>
              </span>
              <span class="task-deadline-wrapper">
                <span class="task-deadline-text" data-action="edit-field-text" data-field="deadline_at" data-id="<%= task.id %>"><%= task.deadline_at %></span>
              </span>
              <span class="<%= task.daysLeft <= 1 ? 'days-critical' : task.daysLeft <= 3 ? 'days-warning' : '' %>" data-days-id="<%= task.id %>"><%= task.daysLeft %></span>
              <span class="task-status <%= getStatusClass(task.status) %>" data-action="edit-status" data-id="<%= task.id %>" data-original-value="<%= task.status %>"><%= task.status %></span>
            </div>

            <div class="task-actions">
              <% if (!task.isSubtask) { %>
              <button data-action="toggle-add-form" data-id="<%= task.id %>" title="Добавить подзадачу">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
              <% } %>

              <% if (user.role === 'admin') { %>
              <form action="/tasks/delete/<%= task.id %>" method="POST" class="delete-form" data-confirm="true">
                <button type="submit" class="delete-btn" title="Удалить задачу">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                </button>
              </form>
              <% } %>
            </div>
          </div>

          <!-- ФОРМА ДЛЯ ДОБАВЛЕНИЯ ПОДЗАДАЧИ -->
          <% if (!task.isSubtask) { %>
          <form action="/tasks" method="POST" id="form-sub-<%= task.id %>" class="task-row is-subtask inline-add-form hidden">
            <input type="hidden" name="parent_id" value="<%= task.id %>">
            <input type="text" name="title" placeholder="Название подзадачи..." required>
            <input type="hidden" name="category" value="">
            <span class="task-category-text" data-action="edit-category" data-is-new="true">Выбрать...</span>

            <input type="hidden" name="priority" value="1">
            <span class="priority-badge priority-low" style="cursor: pointer; margin: 0 auto;" data-action="edit-priority" data-is-new="true">Низкий</span>

            <input type="text" readonly><input type="text" name="assigned_to" placeholder="Ответственный" required>
            <input type="date" name="deadline_at" required>
            <input type="text" readonly><input type="hidden" name="status" value="Открыто">
            <span class="task-status status-open" data-action="edit-status" data-is-new="true">Открыто</span>
            <button type="submit" class="mini-add-btn">ОК</button>
          </form>
          <% } %>
          <% }); %>

          <!-- ФОРМА ДЛЯ ДОБАВЛЕНИЯ ГЛАВНОЙ ЗАДАЧИ -->
          <form action="/tasks" method="POST" class="task-row inline-add-form main-add-row">
            <input type="text" name="title" placeholder="Начните ввод новой задачи..." required>
            <input type="hidden" name="category" value="">
            <span class="task-category-text" data-action="edit-category" data-is-new="true">Выбрать...</span>

            <input type="hidden" name="priority" value="1">
            <span class="priority-badge priority-low" style="cursor: pointer; margin: 0 auto;" data-action="edit-priority" data-is-new="true">Низкий</span>

            <input type="text" readonly class="invisible">
            <input type="text" name="assigned_to" placeholder="Ответственный" required>
            <input type="date" name="deadline_at" required>
            <input type="text" readonly class="invisible">
            <input type="hidden" name="status" value="Открыто">
            <span class="task-status status-open" data-action="edit-status" data-is-new="true">Открыто</span>
            <button type="submit" class="add-btn-large">Добавить задачу</button>
          </form>
        </div>
      </section>
    </main>

    <div id="overlay" class="overlay" data-action="close-details"></div>
    <aside id="details-panel" class="details-panel">
      <button class="close-btn" data-action="close-details">✕</button>
      <div class="panel-content" id="panel-loading">
        <div class="spinner"></div>
      </div>
      <div class="panel-content hidden" id="panel-data">
        <div class="panel-header">
          <span class="panel-id">#<span id="p-id"></span></span>
          <h2 id="p-title" contenteditable="true" class="editable-title" data-action="edit-panel-title"></h2>
        </div>
        <div class="panel-properties">
          <div class="prop-row"><span class="prop-label">Исполнитель</span><span class="prop-value" id="p-assignee" data-action="edit-panel-field" data-field="assigned_to"></span></div>
          <div class="prop-row"><span class="prop-label">Статус</span><span class="prop-value" id="p-status" data-action="edit-panel-status"></span></div>
          <div class="prop-row"><span class="prop-label">Срок</span><span class="prop-value" id="p-deadline" data-action="edit-panel-field" data-field="deadline_at"></span></div>
          <div class="prop-row"><span class="prop-label">Приоритет</span><span class="prop-value" id="p-priority" data-action="edit-panel-priority"></span></div>
        </div>

        <hr class="panel-divider">
        <label class="section-label">Комментарии / Чат</label>
        <div class="chat-section">
          <div id="chat-messages" class="chat-messages">
          </div>
          <div class="chat-input-wrapper">
            <input type="text" id="chat-input" class="chat-input" placeholder="Написать комментарий..." autocomplete="off">
            <button id="chat-send-btn" class="send-btn">➤</button>
          </div>
        </div>
        <hr class="panel-divider">

      </div>
    </aside>
  </div>

  <script type="module" src="/js/main.js"></script>

  <% 
     function getStatusClass(status) {
       switch(status?.toLowerCase()) {
         case 'просрочено': return 'status-overdue';
         case 'открыто': return 'status-open';
         case 'в работе': return 'status-progress';
         case 'готово': return 'status-done';
         case 'на паузе': return 'status-paused';
         case 'отменено': return 'status-cancelled';
         default: return 'status-open';
       }
     }

     function getPriorityClass(p) {
        if(p == 3) return 'priority-high';
        if(p == 2) return 'priority-medium';
        return 'priority-low';
     }

     function getPriorityLabel(p) {
        if(p == 3) return 'Высокий';
        if(p == 2) return 'Средний';
        return 'Низкий';
     }
  %>
</body>

</html>