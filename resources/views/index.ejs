<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Action Tracker | Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/aside-panel.css">
  <script>
    // Передаем категории из EJS в глобальную переменную JS
    window.CATEGORIES = <%- JSON.stringify(categories.map(c => c.name)) %>;
  </script>
</head>

<body>
  <div class="app-container">
    <aside class="sidebar">
      <div class="logo">At</div>
      <nav class="nav-icons">
        <div class="icon active">🏠</div>
        <div class="icon">📊</div>
        <div class="icon">⚙️</div>
      </nav>
    </aside>

    <main class="main-content">
      <section class="table-container">
        <div class="task-table">
          <div class="search-wrapper" style="margin-bottom: 20px;">
            <input type="text" id="taskSearch" placeholder="🔍 Поиск задачи или исполнителя..." onkeyup="filterTasks()" style="width: 100%; padding: 10px; border: 1px solid var(--border-color); border-radius: 8px;">
          </div>

          <div class="table-header">
            <span>Задача</span>
            <span>Категория</span>
            <span title="Подзадачи" style="display: flex; justify-content: center; align-items: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.6;">
                <path d="M3 3h6v6H3zM15 15h6v6h-6zM15 3h6v6h-6zM9 6h6M12 6v12M12 18h3" />
              </svg>
            </span>
            <span>Ответственный</span>
            <span>Срок</span>
            <span>Дней</span>
            <span>Статус</span>
            <span></span>
          </div>

          <% tasks.forEach(task => { %>
          <% const subtaskCount = tasks.filter(t => t.parent_id === task.id).length; %>
          <% const hasChildren = subtaskCount > 0; %>

          <div class="task-row <%= task.isSubtask ? 'is-subtask' : '' %>" <% if (task.isSubtask) { %> data-parent-id="<%= task.parent_id %>" style="display: none;" <% } %>>
            <div class="task-clickable-area">
              <span class="task-title">
                <% if (!task.isSubtask) { %>
                <span class="toggle-icon" onclick="event.stopPropagation(); toggleSubtasks('<%= task.id %>', this)" style="<%= hasChildren ? '' : 'visibility: hidden;' %>">▶</span>
                <% } %>
                <span class="task-title-wrapper">
                  <span class="task-title-text" style="cursor: pointer;" onclick="openDetails('<%= task.id %>')">
                    <%= task.title %>
                  </span>
                  <button class="edit-icon-btn" onclick="event.stopPropagation(); editTask(this.previousElementSibling, '<%= task.id %>', 'title')">✎</button>
                </span>
              </span>

              <span class="task-category-wrapper">
                <span class="task-category-text" style="cursor: pointer;" onclick="event.stopPropagation(); editCategory(this, '<%= task.id %>')">
                  <%= task.category || '—' %>
                </span>
                <!-- <button class="edit-icon-btn" onclick="event.stopPropagation(); editCategory(this.previousElementSibling, '<%= task.id %>')">✎</button> -->
              </span>

              <span class="subtask-count">
                <% if (!task.isSubtask && subtaskCount > 0) { %>
                <span class="subtask-badge <%= subtaskCount > 5 ? 'has-many' : '' %>">
                  <%= subtaskCount %>
                </span>
                <% } %>
              </span>

              <span class="task-assignee-wrapper">
                <span class="task-assignee-text" onclick="event.stopPropagation(); editTask(this, '<%= task.id %>', 'assigned_to')"><%= task.assigned_to %></span>
                <!-- <button class="edit-icon-btn" onclick="event.stopPropagation(); editTask(this.previousElementSibling, '<%= task.id %>', 'assigned_to')">✎</button> -->
              </span>

              <span class="task-deadline-wrapper">
                <span class="task-deadline-text" onclick="event.stopPropagation(); editTask(this, '<%= task.id %>', 'deadline_at')"><%= task.deadline_at %></span>
                <!-- <button class="edit-icon-btn" onclick="event.stopPropagation(); editTask(this.previousElementSibling, '<%= task.id %>', 'deadline_at')">✎</button> -->
              </span>

              <span class="<%= task.daysLeft <= 1 ? 'days-critical' : task.daysLeft <= 3 ? 'days-warning' : '' %>">
                <%= task.daysLeft %>
              </span>

              <span class="task-status <%= task.status?.toLowerCase() === 'просрочено' ? 'status-overdue' : 
                  task.status?.toLowerCase() === 'открыто' ? 'status-open' :
                  task.status?.toLowerCase() === 'в работе' ? 'status-progress' :
                  task.status?.toLowerCase() === 'готово' ? 'status-done' : 
                  task.status?.toLowerCase() === 'на паузе' ? 'status-paused' :
                  task.status?.toLowerCase() === 'отменено' ? 'status-cancelled' : 'status-open' %>" onclick="event.stopPropagation(); editStatus(this, '<%= task.id %>')" data-original-value="<%= task.status %>">
                <%= task.status %>
              </span>
            </div>

            <div class="task-actions">
              <% if (!task.isSubtask) { %>
              <button onclick="event.stopPropagation(); toggleSubtaskForm('<%= task.id %>')" title="Добавить подзадачу">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
              <% } %>
              <form action="/tasks/delete/<%= task.id %>" method="POST" class="delete-form" onclick="event.stopPropagation();" onsubmit="return confirm('Удалить задачу?');">
                <button type="submit" class="delete-btn" title="Удалить задачу">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                </button>
              </form>
            </div>
          </div>

          <% if (!task.isSubtask) { %>
          <form action="/tasks" method="POST" id="form-sub-<%= task.id %>" class="task-row is-subtask inline-add-form hidden">
            <input type="hidden" name="parent_id" value="<%= task.id %>">
            <input type="text" name="title" placeholder="Название подзадачи..." required>

            <input type="hidden" name="category" value="">
            <span class="task-category-text" style="cursor: pointer; min-width: 80px; text-align: center; border-bottom: 1px dashed #ccc;" onclick="event.stopPropagation(); editCategory(this, null, true)">Выбрать...</span>

            <input type="text" readonly>
            <input type="text" name="assigned_to" placeholder="Ответственный" required>
            <input type="date" name="deadline_at" required>
            <input type="text" readonly>
            <input type="hidden" name="status" value="Открыто">
            <span class="task-status status-open" onclick="event.stopPropagation(); editStatus(this, null, true)">Открыто</span>
            <button type="submit" class="mini-add-btn">ОК</button>
          </form>
          <% } %>
          <% }); %>

          <form action="/tasks" method="POST" class="task-row inline-add-form main-add-row">
            <input type="text" name="title" placeholder="Начните ввод новой задачи..." required>

            <input type="hidden" name="category" value="">
            <span class="task-category-text" style="cursor: pointer; min-width: 80px; text-align: center; border-bottom: 1px dashed #ccc;" onclick="event.stopPropagation(); editCategory(this, null, true)">Выбрать...</span>

            <input type="text" readonly class="invisible">
            <input type="text" name="assigned_to" placeholder="Ответственный" required>
            <input type="date" name="deadline_at" required>
            <input type="text" readonly class="invisible">
            <input type="hidden" name="status" value="Открыто">
            <span class="task-status status-open" onclick="event.stopPropagation(); editStatus(this, null, true)">Открыто</span>
            <button type="submit" class="add-btn-large">Добавить задачу</button>
          </form>
        </div>
      </section>
    </main>

    <div id="overlay" class="overlay" onclick="closeDetails()"></div>
    <aside id="details-panel" class="details-panel">
      <button class="close-btn" onclick="closeDetails()">✕</button>

      <div class="panel-content" id="panel-loading">
        <div class="spinner"></div> Загрузка...
      </div>

      <div class="panel-content hidden" id="panel-data">
        <div class="panel-header">
          <span class="panel-id">#<span id="p-id"></span></span>
          <h2 id="p-title" contenteditable="true" class="editable-title"></h2>
        </div>

        <div class="panel-properties">
          <div class="prop-row">
            <span class="prop-label">Исполнитель</span>
            <span class="prop-value" id="p-assignee"></span>
          </div>
          <div class="prop-row">
            <span class="prop-label">Статус</span>
            <span class="prop-value" id="p-status"></span>
          </div>
          <div class="prop-row">
            <span class="prop-label">Срок</span>
            <span class="prop-value" id="p-deadline"></span>
          </div>
          <div class="prop-row">
            <span class="prop-label">Приоритет</span>
            <span class="prop-value" id="p-priority">—</span>
          </div>
        </div>

        <hr class="panel-divider">

        <div class="panel-section">
          <label class="section-label">Заметки / Описание</label>
          <textarea id="p-comments" class="panel-textarea" placeholder="Добавьте описание задачи..."></textarea>
          <div id="save-indicator" class="save-status">Сохранено</div>
        </div>

        <hr class="panel-divider">

        <div class="panel-meta">
          <p>Создано: <span id="p-created"></span></p>
          <p>Обновлено: <span id="p-updated"></span></p>
        </div>
      </div>
    </aside>
  </div>
  <script src="/main.js"></script>
</body>

</html>