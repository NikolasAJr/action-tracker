<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <title>Action Tracker | Администрирование</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin-panel.css">

</head>

<body>
  <div class="app-container">
    <aside class="sidebar">
      <div class="logo">At</div>
      <nav class="nav-icons">
        <a href="/" class="icon" title="Задачи" style="text-decoration:none; display:block; text-align:center;">🏠</a>
        <div class="icon active">👥</div>
      </nav>
      <div style="margin-top: auto; display: flex; flex-direction: column; align-items: center; gap: 10px; padding-bottom: 20px;">
        <div title="<%= user.username %>" style="width: 32px; height: 32px; background: #e4e4e7; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 12px; color: #52525b;">
          <%= user.username.charAt(0).toUpperCase() %>
        </div>
        <a href="/logout" style="text-decoration: none; color: #ef4444; font-size: 20px;">✕</a>
      </div>
    </aside>

    <main class="main-content">
      <h1 style="margin-bottom: 24px; font-size: 24px;">Управление пользователями</h1>

      <table class="admin-table">
        <thead>
          <tr>
            <th style="width: 50px;">ID</th>
            <th>Логин (Windows)</th>
            <th>Полное имя</th>
            <th>Роль</th>
            <th>Действия</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
          <tr>
            <td style="color: var(--text-tertiary);">#<%= u.id %></td>
            <td style="font-weight: 500;"><%= u.username %></td>
            <td><%= u.full_name || '—' %></td>
            <td>
              <select class="role-select" data-action="admin-change-role" data-id="<%= u.id %>">
                <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>Пользователь</option>
                <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Администратор</option>
              </select>
            </td>
            <td>
              <% if (u.id !== user.id) { %>
              <button class="btn-del-user" data-action="admin-delete-user" data-id="<%= u.id %>">Удалить</button>
              <% } else { %>
              <span style="color: #ccc; font-size: 12px;">Это вы</span>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </main>
  </div>
  <script type="module" src="/js/main.js"></script>
</body>

</html>